exec mufradat init ws

mistral-mode rare-first
exec mufradat -C ws add 1
stderr 'wrote 1 note in 2 requests'
grep -count=1 'قَرَأَ \[الْوَلَدُ\] الْكِتَابَ فِي الْبَيْتِ' ws/notes.jsonl

mistral-reset
mistral-mode rare-always
! exec mufradat -C ws add 1
stderr 'does not know yet: الطَّاوِلَةِ \(from طَاوِلَة, frequency rank 1602\)'
stderr '1 note could not be written'
grep -count=1 '"lemma"' ws/notes.jsonl

mistral-reset
exec mufradat -C ws config set author.allow_rank 0
exec mufradat -C ws add 1
stderr 'wrote 1 note in 1 request'
grep -count=2 '"lemma"' ws/notes.jsonl
