exec mufradat init ws
cp notes.jsonl ws/notes.jsonl
exec mufradat auth google --import key.json

env FAKE_BROWSER=compare
exec mufradat -C ws voices compare
stdout 'comparing voices at http://127.0.0.1:[0-9]+/[A-Z2-7]+/'
! stderr 'could not open a browser'
stderr 'google.voice is now ar-XA-Wavenet-A'
grep 'compare current=ar-XA-Chirp3-HD-Achernar voices=2 samples=4' browser.log
grep 'sample word 200 MP3\[ar-XA-Wavenet-A\]كِتَاب' browser.log
grep 'sample sentence 200 MP3\[ar-XA-Wavenet-A\]قَرَأْتُ الْكِتَابَ' browser.log
grep -count=4 'ar-XA-Wavenet-A' synth-calls.log
grep 'use 200' browser.log
exec mufradat -C ws config get google.voice
stdout 'ar-XA-Wavenet-A'
exec mufradat -C ws audio --dry-run
stderr 'with ar-XA-Wavenet-A'

rm browser.log
exec mufradat -C ws config set google.voice ar-XA-Chirp3-HD-Achernar
exec mufradat -C ws voices compare --text 'مَرْحَبًا'
grep 'samples=1' browser.log
grep -count=5 'ar-XA-Wavenet-A' synth-calls.log

exec mufradat -C ws config set google.voice ar-XA-Chirp3-HD-Achernar
exec mufradat -C ws voices compare
grep -count=5 'ar-XA-Wavenet-A' synth-calls.log
exists ws/state/voice-samples

-- notes.jsonl --
{"id":"n_aaaaaaaaaaaa","seq":1,"rank":3,"origin":"ranked","lemma":"كِتَاب","pos":"noun","gender":"m","forms":[{"label":"pl.","ar":"كُتُب"}],"english":"book","example":"قَرَأْتُ [الْكِتَابَ] فِي الْبَيْتِ.","example_en":"I read the book at home.","created":"2023-11-14T22:13:20Z","updated":"2023-11-14T22:13:20Z"}
{"id":"n_bbbbbbbbbbbb","seq":2,"rank":1,"origin":"ranked","lemma":"قَلَم","pos":"noun","gender":"m","forms":[{"label":"pl.","ar":"أَقْلَام"}],"english":"pen","example":"أُرِيدُ [قَلَمًا] جَدِيدًا.","example_en":"I want a new pen.","created":"2023-11-14T22:13:20Z","updated":"2023-11-14T22:13:21Z"}
