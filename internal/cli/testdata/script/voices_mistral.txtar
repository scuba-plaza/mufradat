exec mufradat init ws
cp notes.jsonl ws/notes.jsonl

exec mufradat -C ws voices list
stdout '^\* +voice_479 +Maryam +female'
stdout '^ +33333333-3333-4333-8333-333333333333 +Omar +male'
! stdout 'Oliver'
! stdout 'voice_001'

env MISTRAL_API_KEY=wrong-key
exits 3 mufradat -C ws voices list
stderr 'Unauthorized'
stderr 'hint: check the key with `mufradat -C .*ws doctor`, or import another with `mufradat -C .*ws auth mistral --import FILE`'
env MISTRAL_API_KEY=fake-mistral-key

exec mufradat -C ws voices list --json
stdout '"voice": "voice_479"'
stdout '"name": "Maryam"'
stdout '"gender": "female"'
stdout '"current": true'
! stdout 'Oliver'

exec mufradat -C ws config set mistral.voice maryam
exec mufradat -C ws voices list --json
stdout '"current": true'

exec mufradat -C ws config set mistral.voice voice_479
env FAKE_BROWSER=compare
exec mufradat -C ws voices compare
stdout 'comparing voices at http://127.0.0.1:[0-9]+/[A-Z2-7]+/'
stderr 'mistral.voice is now 33333333-3333-4333-8333-333333333333'
grep 'compare current=voice_479 voices=2 samples=4' browser.log
grep 'sample word 200 MP3\[Omar\]كِتَاب' browser.log
grep 'sample sentence 200 MP3\[Omar\]قَرَأْتُ الْكِتَابَ' browser.log
grep 'use 200' browser.log
exec mufradat -C ws config get mistral.voice
stdout '^33333333-3333-4333-8333-333333333333$'
exec mufradat -C ws config get google.voice
stdout '^ar-XA-Chirp3-HD-Achernar$'
exec mufradat -C ws audio --dry-run
stderr 'with 33333333-3333-4333-8333-333333333333 \(mistral\)'

exec mufradat -C ws config set mistral.voice voice_479
env FAKE_BROWSER=compare-keep
exec mufradat -C ws voices compare
stderr 'the voice was not changed'
! stderr 'is now'
exec mufradat -C ws config get mistral.voice
stdout '^voice_479$'

exec mufradat -C ws config set audio.provider google
exec mufradat auth google --import key.json
exec mufradat -C ws voices list
stdout '^\* +ar-XA-Chirp3-HD-Achernar +female +24 kHz'
stdout '^ +ar-XA-Wavenet-A +female +24 kHz'

-- notes.jsonl --
{"id":"n_aaaaaaaaaaaa","seq":1,"rank":3,"origin":"ranked","lemma":"كِتَاب","pos":"noun","gender":"m","forms":[{"label":"pl.","ar":"كُتُب"}],"english":"book","example":"قَرَأْتُ [الْكِتَابَ] فِي الْبَيْتِ.","example_en":"I read the book at home.","created":"2023-11-14T22:13:20Z","updated":"2023-11-14T22:13:20Z"}
{"id":"n_bbbbbbbbbbbb","seq":2,"rank":1,"origin":"ranked","lemma":"قَلَم","pos":"noun","gender":"m","forms":[{"label":"pl.","ar":"أَقْلَام"}],"english":"pen","example":"أُرِيدُ [قَلَمًا] جَدِيدًا.","example_en":"I want a new pen.","created":"2023-11-14T22:13:20Z","updated":"2023-11-14T22:13:21Z"}
