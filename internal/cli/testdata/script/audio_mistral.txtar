exec mufradat init ws
cp notes.jsonl ws/notes.jsonl

exec mufradat -C ws audio --dry-run
stderr '6 clips wanted, 0 present, 6 to make'
stderr 'with voice_479 \(mistral\)'
! stderr 'rate'
! exists ws/audio/synth
mistral-calls 0

env MISTRAL_API_KEY=
exits 3 mufradat -C ws audio
stderr 'no Mistral API key found'
stderr 'hint: set MISTRAL_API_KEY, or save the key in a file and run `mufradat -C .*ws auth mistral --import FILE`'
env MISTRAL_API_KEY=fake-mistral-key

exec mufradat -C ws audio --limit 2
stderr 'limited to the first 2'
stderr 'made 2 clips'
grep -count=2 '^voice_479$' synth-calls.log

exec mufradat -C ws audio
stderr '6 clips wanted, 2 present, 4 to make'
stderr 'made 4 clips'
exec mufradat -C ws audio
stderr '6 clips wanted, 6 present, 0 to make'
! stderr 'made'
grep -count=6 '^voice_479$' synth-calls.log

exec mufradat -C ws config set audio.rate 1.5
exec mufradat -C ws audio --dry-run
stderr '6 clips wanted, 6 present, 0 to make'
exec mufradat -C ws config set audio.rate 0.9

exec mufradat -C ws build
stderr '2 notes, 4 cards \(2 production\), 6 audio clips'

exec mufradat -C ws config set audio.provider google
exec mufradat -C ws audio --dry-run
stderr '6 clips wanted, 0 present, 6 to make'
stderr 'with ar-XA-Chirp3-HD-Achernar \(google, rate 0.9\)'
exec mufradat auth google --import key.json
exec mufradat -C ws audio
stderr 'made 6 clips'
grep -count=6 'ar-XA-Chirp3-HD-Achernar' synth-calls.log
grep -count=6 '^voice_479$' synth-calls.log
exec mufradat -C ws status
stdout 'build .*out of date'

exec mufradat -C ws config set audio.provider mistral
exec mufradat -C ws audio
stderr '6 clips wanted, 6 present, 0 to make'
grep -count=6 '^voice_479$' synth-calls.log
grep -count=6 'ar-XA-Chirp3-HD-Achernar' synth-calls.log

exec mufradat -C ws audio gc
stderr 'found 6 unused clips'

exec mufradat -C ws config set mistral.voice Maryam
exec mufradat -C ws audio --dry-run
stderr 'with Maryam \(mistral\)'
stderr '6 clips wanted, 0 present, 6 to make'
exec mufradat -C ws audio --limit 1
stderr 'made 1 clips'
grep -count=7 '^voice_479$' synth-calls.log

exec mufradat -C ws config set mistral.voice 11111111-1111-4111-8111-111111111111
exec mufradat -C ws audio --limit 1
stderr 'made 1 clips'
grep -count=8 '^voice_479$' synth-calls.log

exec mufradat -C ws config set mistral.voice voice_999
rm mistral-requests.log
exits 1 mufradat -C ws audio
stderr 'the mistral service has no Arabic voice named "voice_999"'
stderr 'hint: see the choices with `mufradat -C .*ws voices list`, then `mufradat -C .*ws config set mistral.voice NAME`'
grep -count=2 '^voices$' mistral-requests.log
! grep '^speech' mistral-requests.log

-- notes.jsonl --
{"id":"n_aaaaaaaaaaaa","seq":1,"rank":3,"origin":"ranked","lemma":"كِتَاب","pos":"noun","gender":"m","forms":[{"label":"pl.","ar":"كُتُب"}],"english":"book","example":"قَرَأْتُ [الْكِتَابَ] فِي الْبَيْتِ.","example_en":"I read the book at home.","created":"2023-11-14T22:13:20Z","updated":"2023-11-14T22:13:20Z"}
{"id":"n_bbbbbbbbbbbb","seq":2,"rank":1,"origin":"ranked","lemma":"قَلَم","pos":"noun","gender":"m","forms":[{"label":"pl.","ar":"أَقْلَام"}],"english":"pen","example":"أُرِيدُ [قَلَمًا] جَدِيدًا.","example_en":"I want a new pen.","created":"2023-11-14T22:13:20Z","updated":"2023-11-14T22:13:21Z"}
