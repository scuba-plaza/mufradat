exec mufradat init ws

exec mufradat -C ws doctor
stdout 'ok    mistral key +accepted by Mistral \(MISTRAL_API_KEY\)'
! stdout 'google credentials'
grep -count=1 '^models$' mistral-requests.log

env MISTRAL_API_KEY=
exits 3 mufradat -C ws doctor
stdout 'FAIL  mistral key +no Mistral API key; notes cannot be written'
stdout 'hint: set MISTRAL_API_KEY, or run `mufradat -C .*ws auth mistral --import FILE`'
exits 3 mufradat -C ws auth mistral
stderr 'no Mistral API key found'

! exec mufradat auth mistral --import missing.txt
stderr 'missing.txt does not exist'
! exec mufradat auth mistral --import empty.txt
stderr 'empty.txt is empty'
! exec mufradat auth mistral --import spaced.txt
stderr 'spaced.txt contains whitespace or control characters'
! exists home/.config/mufradat/mistral-api-key

exec mufradat auth mistral --import key.txt
stderr 'imported the Mistral API key'
grep '^fake-mistral-key$' home/.config/mufradat/mistral-api-key
exec mufradat auth mistral
stdout '^imported key$'
exec mufradat -C ws doctor
stdout 'ok    mistral key +accepted by Mistral \(imported key\)'

cp notes.jsonl ws/notes.jsonl
env MISTRAL_API_KEY=wrong-key
exits 3 mufradat -C ws doctor
stdout 'FAIL  mistral key +Mistral rejected the key from MISTRAL_API_KEY \(Unauthorized\)'
exits 3 mufradat -C ws add 1
stderr 'the service rejected the credentials: Unauthorized'
exits 3 mufradat -C ws audio
stderr 'mistral: Unauthorized \(HTTP 401\)'
stderr 'hint: check the key with `mufradat -C .*ws doctor`, or import another with `mufradat -C .*ws auth mistral --import FILE`'

env MISTRAL_API_KEY='abc def'
exits 3 mufradat auth mistral
stderr 'MISTRAL_API_KEY contains whitespace or control characters'
env MISTRAL_API_KEY=fake-mistral-key

exec mufradat -C ws config set mistral.endpoint http://127.0.0.1:1
exec mufradat -C ws doctor
stdout 'warn  mistral key +could not check the key from MISTRAL_API_KEY with Mistral'
exec mufradat -C ws config set mistral.endpoint $MISTRAL_URL

exec mufradat -C ws config set audio.provider google
exits 3 mufradat -C ws doctor
stdout 'FAIL  google credentials +no Google credentials; audio cannot be made'
stdout 'hint: run `mufradat -C .*ws auth google --import KEY.json`'
exec mufradat auth google --import key.json
exec mufradat -C ws doctor
stdout 'ok    google credentials +service_account tts@test-project'
stdout 'ok    mistral key'

-- key.txt --
fake-mistral-key
-- empty.txt --

-- spaced.txt --
two words
-- notes.jsonl --
{"id":"n_aaaaaaaaaaaa","seq":1,"rank":3,"origin":"ranked","lemma":"كِتَاب","pos":"noun","gender":"m","forms":[],"english":"book","example":"قَرَأْتُ [الْكِتَابَ] فِي الْبَيْتِ.","example_en":"I read the book at home.","created":"2023-11-14T22:13:20Z","updated":"2023-11-14T22:13:20Z"}
