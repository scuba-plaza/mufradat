env SOURCE_DATE_EPOCH=1700000000

exec mufradat init ws
cp notes.jsonl ws/notes.jsonl
exec mufradat setup
exec mufradat -C ws config set verify.enabled off
exec mufradat -C ws review
stderr 'nothing is flagged because vowel checking is not available'
stderr 'nothing to review'
env FAKE_BROWSER=finish
exec mufradat -C ws review --all
stdout 'reviewing 2 notes at http://127.0.0.1:[0-9]+/[A-Z2-7]+/'
stderr '2 notes: 0 marked right, 0 edited, 0 rewritten by Claude Code, 2 still open'
grep 'finish 200' browser.log
exec mufradat -C ws config set verify.enabled auto

env FAKE_BROWSER=finish
exec mufradat -C ws review --no-check
stderr 'nothing to review'
exec mufradat -C ws check

env FAKE_BROWSER=keep
exec mufradat -C ws review
stdout 'reviewing 1 flagged note at http://127.0.0.1:[0-9]+/[A-Z2-7]+/'
stderr '1 marked right'
stderr 'Next: `mufradat -C .*ws build`'
grep -count=1 'keep 200' browser.log
grep '"kind":"dismiss_issue"' ws/decisions.jsonl
grep 'الْبَيْتِ' ws/decisions.jsonl
exec mufradat -C ws check --strict

exec mufradat -C ws review
stderr 'nothing to review'

rm ws/decisions.jsonl
env FAKE_BROWSER=keep-undo
exec mufradat -C ws review
stderr '0 marked right, 0 edited, 0 rewritten by Claude Code, 1 still open'
grep 'undo 200' browser.log
exec mufradat -C ws status
stdout 'review .*1 notes with open flags \(1 major, 0 minor\)'

env FAKE_BROWSER=edit
exec mufradat -C ws review
stderr '0 marked right, 1 edited, 0 rewritten by Claude Code, 1 still open'
stderr 'Next: `mufradat -C .*ws audio` makes clips for any changed text'
grep 'save 200' browser.log
grep 'settled' browser.log
grep 'edited in review' ws/notes.jsonl
grep -count=1 '^serve$' sidecar.log

cp notes_edited.jsonl ws/notes.jsonl
env FAKE_BROWSER=finish
exec mufradat -C ws review --no-check
stderr '1 note is not checked yet, so they are not listed'
exec mufradat -C ws review
grep -count=2 '^serve$' sidecar.log

-- notes.jsonl --
{"id":"n_aaaaaaaaaaaa","seq":1,"rank":3,"origin":"ranked","lemma":"كِتَاب","pos":"noun","gender":"m","forms":[{"label":"pl.","ar":"كُتُب"}],"english":"book","example":"قَرَأْتُ [الْكِتَابَ] فِي الْبَيْتِ.","example_en":"I read the book at home.","created":"2023-11-14T22:13:20Z","updated":"2023-11-14T22:13:20Z"}
{"id":"n_bbbbbbbbbbbb","seq":2,"rank":1,"origin":"ranked","lemma":"قَلَم","pos":"noun","gender":"m","forms":[{"label":"pl.","ar":"أَقْلَام"}],"english":"pen","example":"أُرِيدُ [قَلَمًا] جَدِيدًا.","example_en":"I want a new pen.","created":"2023-11-14T22:13:20Z","updated":"2023-11-14T22:13:21Z"}
