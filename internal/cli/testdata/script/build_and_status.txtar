env SOURCE_DATE_EPOCH=1700000000

exec mufradat init ws
exec mufradat init empty

exec mufradat -C empty status
stdout 'add .*no notes yet'
stdout 'next: mufradat -C .*empty add'

! exec mufradat -C empty build
stderr 'no notes'

cp notes.jsonl ws/notes.jsonl

exec mufradat -C ws status
stdout 'add .*2 notes'
stdout 'audio .*no Google credentials'
stdout 'build .*no package yet'
stdout 'next: mufradat -C .*ws build'

exec mufradat -C ws status --json
stdout '"name": "audio"'
stdout '"done": false'

exec mufradat -C ws build
stdout 'out/arabic-msa-core\.apkg$'
stderr '2 notes, 4 cards \(2 production\), 0 audio clips'
stderr '6 clips are missing'
stderr 'check::unverified: 2'
exists ws/out/arabic-msa-core.apkg
exists ws/state/last-build.json

cp ws/out/arabic-msa-core.apkg first.apkg
exec mufradat -C ws build
cmp ws/out/arabic-msa-core.apkg first.apkg

exec mufradat -C ws status
stdout 'build .*arabic-msa-core\.apkg'

cp notes_edited.jsonl ws/notes.jsonl
exec mufradat -C ws status
stdout 'build .*out of date'

exec mufradat -C ws build -o custom.apkg
exists custom.apkg
! cmp custom.apkg first.apkg

-- notes.jsonl --
