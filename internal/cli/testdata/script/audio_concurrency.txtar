exec mufradat init ws
cp notes.jsonl ws/notes.jsonl
exec mufradat -C ws config set tts.requests_per_minute 6000

exec mufradat -C ws config set tts.concurrency 1
exec mufradat -C ws audio
stderr 'made 6 clips'
mistral-parallel 1 1

rm ws/audio
mistral-reset
exec mufradat -C ws config set tts.concurrency 4
exec mufradat -C ws audio
stderr 'made 6 clips'
mistral-parallel 2 4

-- notes.jsonl --
