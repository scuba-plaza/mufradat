exec mufradat init ws
exec mufradat -C ws config set author.batch_size 1
exec mufradat -C ws config set author.concurrency 1

mistral-mode limit-after-1
exits 75 mufradat -C ws add 3
stderr 'rate limited: Rate limit exceeded'
stderr 'hint: the service is busy; the finished notes are saved'
stderr 'to write the rest, run: mufradat -C .*ws add 2'
stdout '\tفِي\t'
grep -count=1 '"lemma"' ws/notes.jsonl

mistral-mode ok
exec mufradat -C ws add 2
stderr 'wrote 2 notes'
grep -count=3 '"lemma"' ws/notes.jsonl
grep '"rank":1,' ws/notes.jsonl
grep '"rank":2,' ws/notes.jsonl
grep '"rank":3,' ws/notes.jsonl

mistral-mode plain-text
exits 1 mufradat -C ws add 1
stderr 'unusable answer: the answer is not JSON: this is not json'
stderr '1 note could not be written'
stderr 'hint: run mufradat -C .*ws add 1 to try again'
grep -count=3 '"lemma"' ws/notes.jsonl

mistral-mode invalid-model
mistral-reset
exits 1 mufradat -C ws add 1
stderr 'Invalid model: mistral-medium-latest'
stderr '1 note could not be written'
mistral-calls 1
grep -count=3 '"lemma"' ws/notes.jsonl

mistral-mode unauthorized
exits 3 mufradat -C ws add 1
stderr 'the service rejected the credentials: Unauthorized'
stderr 'hint: check the key with `mufradat -C .*ws doctor`'
! stderr 'wrote 0'
! stderr 'tokens'
grep -count=3 '"lemma"' ws/notes.jsonl

mistral-mode bad-first
mistral-reset
exec mufradat -C ws add 1
stderr 'wrote 1 note in 2 requests'
grep -count=4 '"lemma"' ws/notes.jsonl

mistral-mode switch-pos
mistral-reset
exec mufradat -C ws add ماء --pos noun
stderr 'wrote 1 note in 2 requests'
grep '"pos":"noun"' ws/notes.jsonl
