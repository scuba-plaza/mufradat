{
  "name": "mufradat",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "mufradat": "bin/mufradat"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cypress",
    "test": "vitest run",
    "bench:regex": "vitest run --config vitest.bench.config.mts",
    "e2e": "node scripts/e2e.mjs run",
    "e2e:open": "node scripts/e2e.mjs open"
  },
  "dependencies": {
    "@mufradat/regex": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "axe-core": "^4.14.0",
    "cypress": "^16.2.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
